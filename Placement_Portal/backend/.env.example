# ============================================================
# Backend Environment Variables — DEVELOPMENT
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker Compose use: postgresql://postgres:postgres@postgres:5432/placement_portal
# For local dev use:      postgresql://postgres:your_password@localhost:5432/placement_portal
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_portal

# JWT secret key — CHANGE THIS in production to a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# JWT token expiry (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Allowed CORS origin (the frontend URL)
# During development: http://localhost:5173 (Vite default port)
CORS_ORIGIN=http://localhost:5173

# ============================================================
# TEST environment overrides (used when NODE_ENV=test)
# ============================================================
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_portal_test
