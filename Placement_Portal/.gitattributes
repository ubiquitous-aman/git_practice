# ============================================================
# Git — Force LF line endings for all text files.
#
# Why this matters:
#   Linux uses LF (\n). Windows defaults to CRLF (\r\n).
#   Without this file, Git on Windows converts LF to CRLF on checkout,
#   breaking shell scripts, Dockerfiles, and causing "whole file changed"
#   diffs that pollute code review.
#
# With this file: ALL teammates (Linux + Windows) get LF in their working copy.
#   The .sh files get eol=lf explicitly as an extra safety measure.
#   Binary files (images, fonts, etc.) are marked binary to prevent corruption.
# ============================================================

# Default: normalize all text files to LF on commit, use LF on checkout
* text=auto eol=lf

# Explicitly mark shell scripts as LF (critical — bash breaks on CRLF)
*.sh text eol=lf

# JavaScript, JSON, config files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Dockerfile
Dockerfile    text eol=lf
*.dockerfile  text eol=lf

# Nginx config
*.conf text eol=lf

# Binary files — do not touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.gz   binary
