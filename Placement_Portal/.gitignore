# ─── Environment files (contain real secrets) ──────────────
.env
.env.local
.env.production
.env.test

# ─── Node.js ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build outputs ─────────────────────────────────────────
dist/
build/
.vite/

# ─── Test coverage ─────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs ──────────────────────────────────────────────────
logs/
*.log

# ─── OS files ──────────────────────────────────────────────
.DS_Store            # macOS
Thumbs.db            # Windows
desktop.ini          # Windows

# ─── Editor/IDE files ──────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Docker ────────────────────────────────────────────────
# Keep docker-compose.yml but ignore override files with local settings
docker-compose.override.yml

# ─── Temporary files ───────────────────────────────────────
tmp/
temp/
