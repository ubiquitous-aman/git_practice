/**
 * Jenkinsfile
 * Placement Management Portal — CI Pipeline
 *
 * DevOps Syllabus Coverage:
 *  - Module 3: Version Control / Git (checkout stage)
 *  - Module 4: CI + Jenkins (pipeline definition, stages, automated tests)
 *
 * Pipeline Stages:
 *  1. Checkout   — Pull source code from SCM
 *  2. Install    — Install Node.js dependencies
 *  3. Lint       — Static code quality checks
 *  4. Test       — Run Jest integration test suite
 *  5. Build      — Validate frontend HTML/JS (no build step for plain HTML)
 *  6. Report     — Archive test results
 */

pipeline {
    agent any

    environment {
        NODE_VERSION     = '18'
        BACKEND_DIR      = 'backend'
        FRONTEND_DIR     = 'frontend'
        // Database URLs injected from Jenkins Credentials store — never hardcoded
        DATABASE_URL     = credentials('PLACEMENT_DB_URL')
        TEST_DATABASE_URL = credentials('PLACEMENT_TEST_DB_URL')
        JWT_SECRET       = credentials('PLACEMENT_JWT_SECRET')
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    triggers {
        // Poll SCM every 5 minutes for changes (replace with webhooks in production)
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                echo '── Stage 1: Checkout source code ──'
                checkout scm
                sh 'git log --oneline -5'
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                echo '── Stage 2: Install backend Node.js dependencies ──'
                dir("${BACKEND_DIR}") {
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci'
                }
            }
        }

        stage('Lint Backend') {
            steps {
                echo '── Stage 3: Lint backend source code ──'
                dir("${BACKEND_DIR}") {
                    sh 'npm run lint'
                }
            }
            post {
                failure {
                    echo 'Lint failed — please fix ESLint errors before merging.'
                }
            }
        }

        stage('Run Backend Tests') {
            steps {
                echo '── Stage 4: Run Jest integration test suite ──'
                dir("${BACKEND_DIR}") {
                    sh 'npm test'
                }
            }
            post {
                always {
                    // Archive test results if JUnit reporter is configured
                    // junit "${BACKEND_DIR}/test-results/**/*.xml"
                    echo 'Test stage complete.'
                }
                failure {
                    echo 'Tests failed — blocking pipeline.'
                }
            }
        }

        stage('Validate Frontend') {
            steps {
                echo '── Stage 5: Validate frontend HTML/JS files ──'
                dir("${FRONTEND_DIR}") {
                    // Verify critical HTML files are present
                    sh 'test -f index.html   && echo "index.html OK"   || exit 1'
                    sh 'test -f register.html && echo "register.html OK" || exit 1'
                    sh 'test -f student.html  && echo "student.html OK"  || exit 1'
                    sh 'test -f tpo.html      && echo "tpo.html OK"      || exit 1'
                    sh 'test -f css/styles.css && echo "styles.css OK"   || exit 1'
                    sh 'test -f js/api.js     && echo "api.js OK"        || exit 1'
                }
            }
        }

        stage('Security Audit') {
            steps {
                echo '── Stage 6: npm security audit ──'
                dir("${BACKEND_DIR}") {
                    // Report vulnerabilities but do not fail build on moderate issues
                    sh 'npm audit --audit-level=high || true'
                }
            }
        }

    }

    post {
        success {
            echo """
            ╔══════════════════════════════════════╗
            ║  ✅ CI Pipeline PASSED               ║
            ║  Branch: ${env.BRANCH_NAME}
            ║  Build:  #${env.BUILD_NUMBER}
            ╚══════════════════════════════════════╝
            """
        }
        failure {
            echo """
            ╔══════════════════════════════════════╗
            ║  ❌ CI Pipeline FAILED               ║
            ║  Branch: ${env.BRANCH_NAME}
            ║  Build:  #${env.BUILD_NUMBER}
            ║  Check the stage logs above.
            ╚══════════════════════════════════════╝
            """
        }
        always {
            cleanWs()
        }
    }
}
